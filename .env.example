# ── TalentGraph AI — environment template ────────────────────────────────────
# Copy to .env (git-ignored) only if you need to override defaults.

# Used by docker compose; the backend reads DATABASE_URL directly when set.
DATABASE_URL=postgresql+psycopg://talentgraph:talentgraph@db:5432/talentgraph

# AI mode: auto (OpenAI when a key is present, deterministic demo mode
# otherwise) | demo (force keyless) | openai (force live).
AI_PROVIDER=auto

# Optional — everything below works WITHOUT a key in demo mode.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=384

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3400

# Compose port overrides (defaults chosen to coexist with other local stacks).
WEB_PORT=3400
API_PORT=8300
POSTGRES_PORT=5434
